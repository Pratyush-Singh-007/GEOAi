# GeoAI Outdoor Assistant — Configuration

# SLM Model
SLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
SLM_MAX_TOKENS=1024
SLM_DEVICE=auto
SLM_USE_4BIT=true

# Set to "false" to skip loading the SLM (uses template-based responses)
USE_SLM=true

# Air Quality API (WAQI) — get free token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=demo
